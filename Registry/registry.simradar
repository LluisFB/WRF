state    real  ZH_RAIN_C   {rncz}{ri}{rj}     misc        1       -      h{11}    "zh_rain_c"         "C-band ground radar rain horizontal reflectivity"         "dBz"
state    real  ZH_CNOW_C   {rncz}{ri}{rj}     misc        1       -      h{11}    "zh_cnow_c"         "C-band ground radar snow horizontal reflectivity"         "dBz"
