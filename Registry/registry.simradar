# registry for simrad.AR
#  V. Galligani, L. Fita (CIMA-IFAECI), Argentina
state    real  GATELON     {nr}{zr}{ijr}      misc        1       -      h{11}    "gatelon"           "ground radar gate longitude"                        "degree_east"
state    real  GATELAT     {nr}{zr}{ijr}      misc        1       -      h{11}    "gatelat"           "ground radar gate latitude"                         "degree_north"
state    real  GATEHGT     {nr}{zr}{ijr}      misc        1       -      h{11}    "gatehgt"           "ground radar gate height (4/3 Ref)"                       "m"
state    real  VR          {nr}{zr}{ijr}      misc        1       -      h{11}    "vr"                "ground radar Doppler Velocity"                            "ms-1"

# S-band
