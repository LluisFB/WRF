state    real  VRX         {rnxz}{ri}{rj}     misc        1       -     rh{11}    "vrx"               "ground X-band radar Doppler Velocity"                     "ms-1"
state    real  AIHTOT_X    {rnxz}{ri}{rj}     misc        1       -      h{11}    "aihtot_x"          "X-band ground radar total attenuation"                    "dB/km"
